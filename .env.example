# SvelteKit / Cloudflare Worker runtime
PUBLIC_CONVEX_URL=
CONVEX_ADMIN_TOKEN=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_COOKIE_PASSWORD=

# Keep this in parity with the Convex deployment env if the provider changes.
# The app defaults to google when unset.
YOUTUBE_PIPES_PROVIDER=google
